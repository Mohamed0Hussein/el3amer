{
  "expo": {
    "name": "El3amer",
    "slug": "El3amer",
    "scheme": "com.el3amer.app",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E2560F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.el3amer.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#E2560F"
      },
      "package": "com.el3amer.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "apiUrl": "https://el3amer-backend.vercel.app",
      "eas": {
        "projectId": "e526ceed-5006-4825-be6a-d557d73b1cb4"
      }
    },
    "owner": "mohamed0x1hussein",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#C94A0A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "El3amer uses your location to place your delivery pin on the map."
        }
      ],
      "expo-secure-store"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e526ceed-5006-4825-be6a-d557d73b1cb4"
    }
  }
}
